# Server Environment Variables (.env)
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI in production or local for dev)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/fintrack?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/finance-tracker

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=super_secret_jwt_key_fintrack_2026_change_in_production

# Secret key required ONLY for one-time initialization of initial Admin account
ADMIN_SETUP_SECRET=fintrack_super_secure_admin_setup_passcode_2026

# Allowed Frontend Origins (comma separated if multiple)
ALLOWED_ORIGINS=https://fin-track-orpin.vercel.app,http://localhost:5173
